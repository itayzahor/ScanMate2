# Node.js backend – copy this file to .env and fill in the values.
# Never commit .env to source control.

MONGODB_URI=mongodb://localhost:27017/scanmate
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Generate a strong random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-this-with-a-strong-random-secret-min-32-chars

PORT=4000

# Set to "production" on cloud platforms.
# NODE_ENV=production

# Comma-separated list of allowed CORS origins.
# Leave unset (or remove) to allow all origins in development.
# ALLOWED_ORIGINS=https://yourdomain.com
